# Copy this file to .env.local for your laptop, and add the same values in
# Vercel → Project → Settings → Environment Variables.
# Never commit .env.local (it's in .gitignore).

# --- Used by the app (safe to be public) ---
# Supabase → Project Settings → API Keys
VITE_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# The public address of the web app (no slash at the end).
VITE_SITE_URL=https://medcheck-steel.vercel.app

# The MedCheck website with the privacy policy, terms and support pages.
# Leave empty until the website is live.
VITE_WEBSITE_URL=

# --- Server only (add in Vercel, never in a VITE_ variable) ---
# Supabase → Project Settings → API Keys → Secret keys. Used by api/delete-account.js.
SUPABASE_SECRET_KEY=sb_secret_...
